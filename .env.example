GOOGLE_API_KEY:
EMBEDDING_MODEL:

CHROMA_PATH:
COLLECTION_NAME:

# Public HTTPS URL the browser should call for the API. Baked into the
# frontend bundle at `docker compose build` time - since nginx proxies
# /legalRag/api/* to the backend on the same origin, this stays same-origin
# and needs no CORS. Update the domain if it's not app.adityakashyap.work.
NEXT_PUBLIC_API_URL=https://app.adityakashyap.work/legalRag/api

# Comma-separated allowlist for the backend's CORS middleware. Only needed
# if something calls the API cross-origin (direct API access, a different
# frontend deployment, etc) - the nginx-proxied frontend above doesn't need
# it since it's same-origin.
CORS_ORIGINS=https://app.adityakashyap.work